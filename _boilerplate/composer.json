{
    "name": "leastudios/plugin-name",
    "description": "A WordPress plugin by leaStudios.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2"
    },
    "autoload": {
        "psr-4": {
            "LEAStudios\\PluginName\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2"
        }
    },
    "scripts": {
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "phpstan": "phpstan analyse --memory-limit=2G",
        "lint:db": "bash bin/check-db-interpolation.sh",
        "lint": [
            "@phpcs",
            "@phpstan",
            "@lint:db"
        ],
        "test": "phpunit"
    }
}
